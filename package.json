{
    "name": "gantt-task-editor",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && node scripts/prepare-cloudflare-pages.js",
        "check:artifacts": "node scripts/prepare-cloudflare-pages.js --check",
        "executor:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/executor/executor.ps1 start",
        "executor:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/executor/executor.ps1 stop",
        "executor:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/executor/executor.ps1 status",
        "executor:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/executor/executor.ps1 logs",
        "feedback:worker:dev": "wrangler dev --config wrangler.toml --port 8787",
        "feedback:worker:dry-run": "wrangler deploy --dry-run --config wrangler.toml",
        "feedback:migrate:local": "wrangler d1 migrations apply FEEDBACK_DB --local --config wrangler.toml",
        "feedback:migrate:remote": "wrangler d1 migrations apply FEEDBACK_DB --remote --config wrangler.toml",
        "deploy": "npm run build && npx wrangler pages deploy dist-cn --project-name gantt-task-editor --branch master",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:workbench": "playwright test --config playwright.workbench.config.js",
        "smoke:prod": "node -e \"const{execSync}=require('child_process');execSync('npx playwright test tests/e2e/prod-smoke.spec.js --project=chromium',{stdio:'inherit',env:{...process.env,SMOKE_PROD_URL:process.env.SMOKE_PROD_URL||'https://gantt-task-editor.pages.dev'}})\"",
        "lint": "eslint src tests",
        "lint:fix": "eslint src tests --fix",
        "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
        "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
        "check": "npm run lint && npm run format:check",
        "check:scenarios": "node scripts/check-scenario-coverage.mjs",
        "check:migrations": "node scripts/check-feedback-migrations.mjs",
        "check:full": "npm run lint && npm run format:check && npm run test",
        "prepare": "husky",
        "agent:preflight": "node scripts/agent-preflight.mjs"
    },
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@tailwindcss/postcss": "^4.1.18",
        "@testsprite/testsprite-mcp": "^0.0.18",
        "@vitest/ui": "^2.1.9",
        "autoprefixer": "^10.4.23",
        "daisyui": "^5.5.14",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "espree": "^10.4.0",
        "fake-indexeddb": "^6.2.5",
        "happy-dom": "^20.1.0",
        "husky": "^9.1.7",
        "jsdom": "^24.1.0",
        "lint-staged": "^16.4.0",
        "postcss": "^8.5.6",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.1.18",
        "vite": "^5.4.0",
        "vitest": "^2.1.9",
        "wrangler": "4.114.0",
        "xlsx": "^0.18.5"
    },
    "dependencies": {
        "@ai-sdk/openai": "^3.0.12",
        "@rrweb/record": "^2.0.0-alpha.20",
        "@rrweb/replay": "^2.0.0-alpha.20",
        "@zumer/snapdom": "^2.15.0",
        "ai": "^6.0.39",
        "dexie": "^4.2.1",
        "exceljs": "^4.4.0",
        "jspdf": "^4.2.1",
        "marked": "^17.0.1",
        "quill": "^2.0.3",
        "sortablejs": "^1.15.7",
        "zod": "^3.24.1"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    }
}
